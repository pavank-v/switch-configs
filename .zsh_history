\
echo\
echo "===== GTK 3 CONFIG ====="\
ls -la ~/.config/gtk-3.0/ 2>&1\
\
echo\
echo "===== ORCHIS GTK 4 FILES ====="\
find ~/.themes/Orchis-Dark -maxdepth 2 -type f \\
  \( -name 'gtk.css' -o -name 'gtk-dark.css' \\
     -o -name 'gnome-shell.css' \) -print\
\
