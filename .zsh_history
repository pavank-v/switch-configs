: 1792857176:0;echo "===== SYSTEM ====="\
cat /etc/os-release | grep PRETTY_NAME\
gnome-shell --version\
pacman -Q gnome-shell gtk3 gtk4 mutter 2>/dev/null\
\
echo\
echo "===== GNOME APPEARANCE ====="\
for key in gtk-theme icon-theme cursor-theme font-name \\
           monospace-font-name color-scheme; do\
    printf "%-22s " "$key"\
    gsettings get org.gnome.desktop.interface "$key" 2>&1\
done\
\
echo\
echo "===== SHELL THEME ====="\
gsettings get org.gnome.shell.extensions.user-theme name 2>&1\
\
echo\
echo "===== ENABLED EXTENSIONS ====="\
gnome-extensions list --enabled\
\
echo\
echo "===== INSTALLED CUSTOM THEMES ====="\
for dir in ~/.themes ~/.local/share/themes \\
           ~/.icons ~/.local/share/icons; do\
    if [ -d "$dir" ]; then\
        echo "--- $dir"\
        ls -1 "$dir"\
    fi\
done\
\
echo\
echo "===== RECENT RELEVANT UPDATES ====="\
grep -E '\[ALPM\] upgraded (gnome-shell|gtk3|gtk4|mutter|gnome-shell-extensions|gnome-tweaks)' \\
    /var/log/pacman.log | tail -20
: 1792857224:0;echo "===== GTK 4 CONFIG ====="\
