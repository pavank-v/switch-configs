#include <SDL2/SDL.h>\
#include <stdio.h>\
\
int main(void) {\
    SDL_Init(SDL_INIT_GAMECONTROLLER | SDL_INIT_JOYSTICK);\
\
    int n = SDL_NumJoysticks();\
    printf("Joysticks: %d\n", n);\
\
    for (int i = 0; i < n; i++) {\
        printf("\nJoystick %d: %s\n", i, SDL_JoystickNameForIndex(i));\
        printf("Is GameController: %s\n",\
               SDL_IsGameController(i) ? "YES" : "NO");\
\
        if (SDL_IsGameController(i)) {\
            SDL_GameController *gc = SDL_GameControllerOpen(i);\
            if (gc) {\
                printf("Controller: %s\n", SDL_GameControllerName(gc));\
                printf("Mapping:\n%s\n", SDL_GameControllerMapping(gc));\
                SDL_GameControllerClose(gc);\
            }\
        }\
    }\
\
    SDL_Quit();\
    return 0;\
}\
EOF\
